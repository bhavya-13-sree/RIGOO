# ==============================================================
# RIGOO — Share the Journey | Environment Configuration Example
# ==============================================================
# Copy this file to .env and replace placeholder values with your real configuration.
# Never commit your actual .env file or real secrets to Git.

# Gemini AI / Lyra AI API Key (Optional: for RideMate AI commuter copilot)
GEMINI_API_KEY="your_gemini_api_key_here"

# Application URL
APP_URL="http://localhost:3000"

# JWT Secret for authenticating users & generating secure session tokens
JWT_SECRET="your_jwt_secret_key_here"

# MySQL Database Configuration (Optional: If MySQL is not configured, RIGOO automatically uses built-in persistent storage fallback)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password_here"
MYSQL_DATABASE="rigoo_db"

# Google Maps API Key (Optional: Photon / OpenStreetMap routing and geocoding work out of the box without keys)
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# Lyra AI / RideMate Service configuration (Optional)
LYRA_API_KEY=""
LYRA_API_ENDPOINT="https://api.lyra.ai/v1"
